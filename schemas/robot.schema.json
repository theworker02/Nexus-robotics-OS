{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus robot definition",
  "type": "object",
  "required": ["name", "runtime"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "runtime": {"type": "object", "required": ["adapter"], "properties": {"adapter": {"type": "string"}}},
    "joints": {"type": "object"},
    "sensors": {"type": "object"}
  }
}
